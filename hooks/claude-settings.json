    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "curl -s -m 2 -H \"Content-Type: application/json\" --data-binary @- http://localhost:5179/claude", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "curl -s -m 2 -H \"Content-Type: application/json\" --data-binary @- http://localhost:5179/claude", "timeout": 5 }] }
    ]
  }
}
