<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="560" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextElement.FontFamily="{DynamicResource UiFont}" TextElement.Foreground="{DynamicResource TextPrimary}">
    <!-- Fully transparent pixels of a layered window are click-through, so only the black island catches the mouse. -->
    <Grid x:Name="Root">
        <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
              MouseRightButtonUp="Island_MouseRightButtonUp"
              AllowDrop="True" DragEnter="Island_DragEnter" DragOver="Island_DragOver"
              DragLeave="Island_DragLeave" Drop="Island_Drop" RenderTransformOrigin="0.5,0">
            <!-- Hide / show: the island springs up into the top edge (narrowing as it goes) and drops back out. -->
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandSquash" />
                    <TranslateTransform x:Name="IslandSlide" />
                </TransformGroup>
            </Grid.RenderTransform>
            <!-- The black capsule: its size and corner radius are driven by springs. -->
            <Border x:Name="Pill" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Top" />
            <!-- Theme overlays, sized with the capsule every frame: "mossy" grain and the glass sheen. -->
            <Border x:Name="PillTexture" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                    Visibility="Collapsed" />
            <Border x:Name="PillSheen" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                    Visibility="Collapsed" BorderThickness="1" BorderBrush="#38FFFFFF">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Content is laid out at its final size and revealed by clipping to the capsule. -->
            <ContentControl x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Top" Focusable="False"
                            RenderTransformOrigin="0.5,0.3">
                <ContentControl.RenderTransform>
                    <ScaleTransform x:Name="HostScale" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
