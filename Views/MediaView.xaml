<local:IslandView x:Class="DynamicIsland.Views.MediaView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DynamicIsland.Views">
    <Grid>
        <!-- Compact: artwork left, equalizer right -->
        <Grid x:Name="CompactRoot" Margin="7,0,12,0">
            <Border Width="24" Height="24" CornerRadius="6" HorizontalAlignment="Left">
                <Border.Background>
                    <ImageBrush x:Name="CompactArt" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <StackPanel x:Name="CompactBars" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Height="16" />
        </Grid>

        <!-- Expanded: artwork + titles, timeline, controls -->
        <Grid x:Name="ExpandedRoot" Margin="20,18,20,12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="12">
                    <Border.Background>
                        <ImageBrush x:Name="ExpandedArt" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Text="Not playing" />
                    <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel x:Name="ExpandedBars" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Height="20" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0" x:Name="TimelineRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" FontSize="11" Foreground="{StaticResource TextSecondary}" Text="0:00" />
                <ProgressBar x:Name="Progress" Grid.Column="1" Style="{StaticResource SlimBar}" VerticalAlignment="Center" />
                <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="11" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Right" Text="0:00" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource IslandButton}" Content="&#xE892;" Click="Prev_Click" />
                <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}" FontSize="24" Width="48" Height="48"
                        Margin="18,0" Content="&#xE768;" Click="PlayPause_Click" />
                <Button Style="{StaticResource IslandButton}" Content="&#xE893;" Click="Next_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</local:IslandView>
