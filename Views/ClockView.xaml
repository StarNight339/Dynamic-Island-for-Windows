<local:IslandView x:Class="DynamicIsland.Views.ClockView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DynamicIsland.Views">
    <!-- Shown when nothing else is going on: an empty pill that opens into a clock + quick timers. -->
    <Grid>
        <Grid x:Name="CompactRoot" />

        <Grid x:Name="ExpandedRoot" Margin="22,14,20,14" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TimeText" FontSize="36" FontWeight="Light" />
                <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
            <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,0,0">
                <TextBlock x:Name="BatteryText" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="BatteryIcon" Style="{StaticResource Icon}" FontSize="18" Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-3,8,0,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="14" Margin="0,0,6,0"
                           Foreground="{StaticResource AccentOrange}" />
                <Button Style="{StaticResource ChipButton}" Content="1 min" Tag="1" Click="Timer_Click" />
                <Button Style="{StaticResource ChipButton}" Content="5 min" Tag="5" Click="Timer_Click" />
                <Button Style="{StaticResource ChipButton}" Content="10 min" Tag="10" Click="Timer_Click" />
                <Button Style="{StaticResource ChipButton}" Content="25 min" Tag="25" Click="Timer_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</local:IslandView>
