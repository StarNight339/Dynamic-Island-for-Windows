<local:IslandView x:Class="DynamicIsland.Views.ProgressView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
                  xmlns:local="clr-namespace:DynamicIsland.Views">
    <!-- A task pushed over the API: badge + title, with a bar and percentage. -->
    <Grid>
        <Grid x:Name="CompactRoot" Margin="8,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CompactBadge" Width="22" Height="22" CornerRadius="11" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="CompactIcon" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Center" />
                    <emoji:TextBlock x:Name="CompactEmoji" FontSize="14" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>
            <emoji:TextBlock x:Name="CompactTitle" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Margin="8,0,8,0"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="CompactBar" Style="{StaticResource SlimBar}" Width="60" />
                <TextBlock x:Name="CompactPercent" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                           MinWidth="34" TextAlignment="Right" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ExpandedRoot" Margin="18,16,22,16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Badge" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top">
                <Grid>
                    <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" />
                    <emoji:TextBlock x:Name="EmojiIcon" FontSize="26" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,1,0,0">
                <emoji:TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <emoji:TextBlock x:Name="BodyText" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                                 TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="Bar" Style="{StaticResource SlimBar}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Percent" Grid.Column="1" FontSize="11" Foreground="{StaticResource TextSecondary}"
                               Margin="10,0,0,0" MinWidth="30" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</local:IslandView>
