<local:IslandView x:Class="DynamicIsland.Views.QuickPanelView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DynamicIsland.Views">
    <!-- Right-click panel: quick timers, quick toggles from the settings sections, settings + exit. -->
    <Grid>
        <Grid x:Name="CompactRoot" />

        <Grid x:Name="ExpandedRoot" Margin="16,12,12,14" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Height="34">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CancelTimerButton" Style="{StaticResource IslandButton}" Width="32" Height="32" FontSize="13"
                            Foreground="{StaticResource AccentOrange}" Content="&#xE711;" ToolTip="Cancel timer"
                            Click="CancelTimer_Click" />
                    <Button Style="{StaticResource IslandButton}" Width="32" Height="32" FontSize="15" Content="&#xE713;"
                            ToolTip="Settings" Click="Settings_Click" />
                    <Button Style="{StaticResource IslandButton}" Width="32" Height="32" FontSize="15" Content="&#xE7E8;"
                            Foreground="{StaticResource AccentRed}" ToolTip="Exit" Click="Exit_Click" />
                </StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="14" Margin="0,0,6,0"
                           Foreground="{StaticResource AccentOrange}" />
                <StackPanel x:Name="TimerChips" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>

            <UniformGrid x:Name="Toggles" Grid.Row="1" Columns="2" Margin="-3,8,1,0" />
        </Grid>
    </Grid>
</local:IslandView>
