<local:IslandView x:Class="DynamicIsland.Views.FileShelfView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DynamicIsland.Views">
    <!-- File shelf: files dropped on the island, with copy / copy path / open / reveal / remove and drag-out. -->
    <Grid>
        <Grid x:Name="CompactRoot" Margin="14,0,16,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="15" Foreground="{StaticResource AccentOrange}" />
                <TextBlock x:Name="CompactCount" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="CompactName" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid x:Name="ExpandedRoot" Margin="16,12,16,12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChipButton}" Click="CopyAll_Click" ToolTip="Copy every file on the shelf">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="11" Margin="0,0,5,0" />
                            <TextBlock Text="Copy all" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Click="CopyAllPaths_Click" ToolTip="Copy every path as text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="11" Margin="0,0,5,0" />
                            <TextBlock Text="Paths" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Click="Clear_Click" ToolTip="Remove everything from the shelf (files stay on disk)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="11" Margin="0,0,5,0"
                                       Foreground="{StaticResource AccentRed}" />
                            <TextBlock Text="Clear" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Foreground="{StaticResource AccentOrange}" />
                <TextBlock x:Name="TitleText" Text="Shelf" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="12" Margin="10,0,8,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,6,0,0">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Focusable="False" PreviewMouseWheel="Scroller_PreviewMouseWheel">
                    <StackPanel x:Name="Tiles" Orientation="Horizontal" />
                </ScrollViewer>

                <!-- Drop zone: shown when the shelf is empty or files are being dragged in. -->
                <Border x:Name="DropZone" CornerRadius="16" Background="#14FFFFFF" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid>
                        <Rectangle RadiusX="16" RadiusY="16" Stroke="#66FFFFFF" StrokeThickness="1.5" StrokeDashArray="4 3" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="22" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DropZoneText" Text="Drop files here" FontSize="13" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</local:IslandView>
