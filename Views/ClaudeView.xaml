<local:IslandView x:Class="DynamicIsland.Views.ClaudeView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:DynamicIsland.Views">
    <Grid>
        <Grid x:Name="CompactRoot" Margin="12,0,14,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="CompactSpark" Text="✳" FontFamily="Segoe UI Symbol" FontSize="17"
                           Foreground="{StaticResource AccentClaude}" RenderTransformOrigin="0.5,0.55" TextTrimming="None">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="CompactSpin" />
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="CompactLabel" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                           VerticalAlignment="Center" MaxWidth="170" />
            </StackPanel>
            <TextBlock x:Name="CompactElapsed" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource AccentClaude}" />
        </Grid>

        <Grid x:Name="ExpandedRoot" Margin="18,16,20,16" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="#33D97757" VerticalAlignment="Top">
                <TextBlock x:Name="Spark" Text="✳" FontFamily="Segoe UI Symbol" FontSize="24" TextTrimming="None"
                           Foreground="{StaticResource AccentClaude}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" RenderTransformOrigin="0.5,0.55">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="Spin" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,1,8,0">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="ProjectText" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" />
                <TextBlock x:Name="DetailText" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="36" />
            </StackPanel>
            <TextBlock x:Name="Elapsed" Grid.Column="2" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentClaude}" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</local:IslandView>
