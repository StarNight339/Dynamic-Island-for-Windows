<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings"
        Width="880" Height="600" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#FF202020"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextElement.FontFamily="{StaticResource UiFont}" TextElement.Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <!-- Sidebar entry: rounded highlight with an accent pill on the selected one (Windows 11 Settings style) -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <!-- ListBox's default style sets a black foreground; set ours explicitly. -->
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="14,9">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="#FF0A84FF"
                                    HorizontalAlignment="Left" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#17FFFFFF" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim overlay-ish scrollbar, scoped to this window -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" CornerRadius="3" Background="#40FFFFFF" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#70FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="12,14,6,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,4,0,22">
                <Border Width="30" Height="14" CornerRadius="7" Background="Black" BorderBrush="#40FFFFFF" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource AccentGreen}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                </Border>
                <TextBlock Text="Dynamic Island" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Focusable="False"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="16" Width="20" />
                            <TextBlock Text="{Binding Title}" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Margin="28,22,28,18" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,22,24" Focusable="False">
                <StackPanel x:Name="Page">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="PageShift" />
                    </StackPanel.RenderTransform>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
